# Keep secrets, local state, and build artifacts out of the image build context.

# Secrets & local environment
.env
.env.*
!.env.example
!.env.gcp.example

# Local state / runtime data
data/
*.db
*.log

# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Version control & editor
.git/
.gitignore
.vscode/
.idea/

# Deployment docs & helpers not needed inside the image
DEPLOY_GCP.md
deploy_gcp.sh
deploy_gcp.ps1
cloudbuild.yaml
.dockerignore
tests/

# Build artifacts / scratch files
*.zip
README.md
.env-vars.gcp.yaml
