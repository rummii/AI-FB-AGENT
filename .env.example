# AI provider: gemini, openai, or grok (xAI)
# gemini -> GEMINI_BASE_URL + AI_MODEL=gemini-flash-latest
# openai -> OPENAI_BASE_URL + AI_MODEL=gpt-4o-mini
# grok   -> OPENAI_BASE_URL=https://api.x.ai/v1 + AI_MODEL=grok-4-latest
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_key
AI_MODEL=gemini-flash-latest
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# News source
NEWS_PROVIDER=newsapi
NEWS_API_KEY=your_newsapi_key
NEWS_LANGUAGE=en
RSS_FEEDS=https://venturebeat.com/ai/feed/,https://openai.com/news/rss.xml,https://www.anthropic.com/news/rss.xml,https://techcrunch.com/category/artificial-intelligence/feed/
NEWS_LOOKBACK_HOURS=48
MAX_CANDIDATES=10

# Facebook page credentials
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# Post generation
POST_TONE=concise, useful, and founder-friendly
MAX_POST_CHARS=420
DRY_RUN=true

# Local storage
HISTORY_DB_PATH=data/posts.db