# AI provider: gemini, openai, or grok (xAI)
# gemini -> GEMINI_BASE_URL + AI_MODEL=gemini-flash-latest
# openai -> OPENAI_BASE_URL + AI_MODEL=gpt-4o-mini
# grok   -> OPENAI_BASE_URL=https://api.x.ai/v1 + AI_MODEL=grok-4-latest
AI_PROVIDER=gemini
AI_API_KEY=your_ai_provider_key
AI_MODEL=gemini-flash-latest
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Universal endpoint override: overrides OPENAI_BASE_URL / GEMINI_BASE_URL.
# Example with a Groq key (AI_PROVIDER=openai):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=

# News source
NEWS_PROVIDER=newsapi
NEWS_API_KEY=your_newsapi_key
NEWS_LANGUAGE=en
RSS_FEEDS=https://venturebeat.com/ai/feed/,https://openai.com/news/rss.xml,https://www.anthropic.com/news/rss.xml,https://techcrunch.com/category/artificial-intelligence/feed/
NEWS_LOOKBACK_HOURS=48
MAX_CANDIDATES=10

# Facebook page credentials
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token

# Post generation
POST_TONE=concise, useful, and founder-friendly
MAX_POST_CHARS=420
DRY_RUN=true

# --- Optional scheduling (recommended once DRY_RUN=false) ---
# Post only at these hours (0-23) of POST_TIMEZONE; empty = post on every cron run.
# If set, schedule the cron job to run every few minutes and the app decides the
# actual posting time, so the server's timezone no longer matters.
POST_TIMES=
# IANA timezone used for POST_TIMES (e.g. America/New_York). Empty = server local time.
POST_TIMEZONE=
# Minimum hours between real posts (0 = disabled). Prevents multiple posts when the
# cron fires more than once inside the same posting hour.
MIN_POST_INTERVAL_HOURS=0

# Posting history (Neon / Postgres). Get the connection string from the Neon
# console -> Connect. The posted_articles table is created on the first run.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require