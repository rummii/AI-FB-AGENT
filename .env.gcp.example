# ------------------------------------------------------------------
# .env.gcp.example — Google Cloud deployment variable map.
#
# DO NOT put real secrets in this file. It documents WHICH variables become
# Secret Manager secrets (SECRET) and which are plain env vars (PLAIN) on the
# Cloud Run Job. The deploy script (deploy_gcp.sh / deploy_gcp.ps1) reads your
# existing local .env for the SECRET values and creates the secrets for you.
#
# On Cloud Run the agent reads these from the process environment. The app's
# .env loader still works locally, but no .env file is shipped in the image.
# ------------------------------------------------------------------

# --- SECRET (stored in Secret Manager, mounted via --set-secrets) ---
AI_API_KEY=your_provider_api_key              # SECRET
NEWS_API_KEY=your_newsapi_key                 # SECRET
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_token    # SECRET
DATABASE_URL=postgresql://...                 # SECRET (Neon connection string)

# --- PLAIN (non-sensitive, passed with --set-env-vars) ---
AI_PROVIDER=openai
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

NEWS_PROVIDER=newsapi
NEWS_LANGUAGE=en
RSS_FEEDS=https://venturebeat.com/ai/feed/,https://openai.com/news/rss.xml,https://www.anthropic.com/news/rss.xml,https://techcrunch.com/category/artificial-intelligence/feed/
NEWS_LOOKBACK_HOURS=48
MAX_CANDIDATES=10

FACEBOOK_PAGE_ID=1209494728920934

# --- PLAIN: post generation ---
POST_TONE=concise, useful, and founder-friendly
MAX_POST_CHARS=420
# Keep DRY_RUN=true for the first Cloud Run Job execution, then set to false.
DRY_RUN=true

# --- PLAIN: scheduling gates enforced inside the app ---
# Cloud Scheduler fires the job at the configured hours; these gates are a
# second safety net. Empty POST_TIMES = post on every job run.
POST_TIMES=11,18
POST_TIMEZONE=Asia/Manila
MIN_POST_INTERVAL_HOURS=6

